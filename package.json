{
  "name": "breeze-framework",
  "version": "2.2.0",
  "description": "Ultra-lightweight declarative web framework",
  "main": "breeze.js",
  "bin": {
    "breeze": "./breeze-cli.js"
  },
  "scripts": {
    "dev": "node breeze-cli.js dev",
    "build": "node build-showcase.js",
    "build:cli": "node breeze-cli.js build",
    "showcase:dev": "node breeze-cli.js dev showcase",
    "showcase:build": "node build-showcase.js",
    "start": "node breeze-cli.js serve dist",
    "preview": "node breeze-cli.js preview dist",
    "lint:breeze": "node breeze-cli.js lint",
    "format:breeze": "node breeze-cli.js format",
    "doctor": "node breeze-cli.js doctor",
    "clean": "node breeze-cli.js clean",
    "test": "node --test",
    "bench": "node bench.js",
    "bench:public": "node benchmarks/krausest-runner.js",
    "bench:bundle": "node benchmarks/bundle-runner.js",
    "bench:ssr": "node benchmarks/ssr-runner.js",
    "bench:dbmonster": "node benchmarks/dbmonster-runner.js",
    "bench:mount10k": "node benchmarks/mount-10k-runner.js",
    "bench:update1row": "node benchmarks/update-1-row-runner.js",
    "bench:filter": "node benchmarks/filter-search-runner.js",
    "bench:sort": "node benchmarks/sort-1k-runner.js",
    "bench:nested": "node benchmarks/nested-list-runner.js",
    "bench:forms": "node benchmarks/form-validate-runner.js",
    "bench:routes": "node benchmarks/route-match-runner.js",
    "bench:hydrate": "node benchmarks/hydrate-string-runner.js",
    "bench:todo": "node benchmarks/todo-mvc-runner.js",
    "bench:sustained": "node benchmarks/sustained-updates-runner.js",
    "bench:v2": "node benchmarks/mount-10k-runner.js && node benchmarks/update-1-row-runner.js && node benchmarks/filter-search-runner.js && node benchmarks/sort-1k-runner.js && node benchmarks/nested-list-runner.js && node benchmarks/form-validate-runner.js && node benchmarks/route-match-runner.js && node benchmarks/hydrate-string-runner.js && node benchmarks/todo-mvc-runner.js && node benchmarks/sustained-updates-runner.js",
    "bench:append-profile": "node benchmarks/append-profile-runner.js",
    "bench:pageload": "node benchmarks/page-load-runner.js",
    "bench:families": "node benchmarks/workload-families-runner.js",
    "bench:build-perf": "node benchmarks/build-perf-runner.js",
    "bench:parse": "node benchmarks/parse-latency-runner.js",
    "bench:bulk": "node benchmarks/bulk-serialization-runner.js",
    "bench:all": "node benchmarks/run-all.js",
    "profile": "node breeze-cli.js profile"
  },
  "types": "breeze.d.ts",
  "keywords": [
    "framework",
    "web",
    "lightweight",
    "declarative",
    "frontend"
  ],
  "author": "Breeze Framework Contributors",
  "license": "MIT",
  "files": [
    "breeze.js",
    "breeze.d.ts",
    "breeze.css",
    "breeze-cli.js",
    "index.html",
    "showcase"
  ],
  "engines": {
    "node": ">=18"
  }
}
